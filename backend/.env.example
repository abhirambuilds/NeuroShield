# ---- Kaggle credentials (required for the real dataset) ----
# Get these from https://www.kaggle.com/settings -> "Create New API Token".
# Either set these two variables, or place kaggle.json at ~/.kaggle/kaggle.json.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ---- Dataset ----
NEUROSHIELD_KAGGLE_DATASET=libiaestvez/multimodal-dataset-for-classifying-cognitive-load
# Leave empty to auto-detect the label column.
NEUROSHIELD_TARGET_COLUMN=
# Set to true ONLY for offline development/tests (uses a random synthetic dataset).
NEUROSHIELD_ALLOW_SYNTHETIC=false

# ---- Reproducibility ----
NEUROSHIELD_RANDOM_SEED=42
NEUROSHIELD_TEST_SIZE=0.25

# ---- Bayesian sampler (kept modest so training is feasible) ----
NEUROSHIELD_BAYES_DRAWS=400
NEUROSHIELD_BAYES_TUNE=400
NEUROSHIELD_BAYES_CHAINS=1
NEUROSHIELD_BAYES_MAX_FEATURES=25
NEUROSHIELD_BAYES_MAX_ROWS=4000

# ---- Kernel SVM training subsample (scales quadratically) ----
NEUROSHIELD_KERNEL_MAX_ROWS=5000

# ---- Model selection criterion for "Automatic" prediction mode ----
# One of: accuracy | precision | recall | f1
NEUROSHIELD_SELECTION_METRIC=f1

# ---- API ----
NEUROSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
